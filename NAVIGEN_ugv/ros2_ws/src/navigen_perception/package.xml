<?xml version="1.0"?>
<package format="3">
  <name>navigen_perception</name>
  <version>0.1.0</version>
  <description>Traversability segmentation with swappable backends (mock, ONNX).</description>
  <maintainer email="team@navigen.local">NAVIGEN Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
