<?xml version="1.0"?>
<package format="3">
  <name>navigen_hardware</name>
  <version>0.1.0</version>
  <description>Skid-steer kinematics, ESP32 serial protocol and bridge node (with mock mode).</description>
  <maintainer email="team@navigen.local">NAVIGEN Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>navigen_interfaces</depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
